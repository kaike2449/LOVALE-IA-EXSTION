{
  "manifest_version": 3,
  "name": "Sessão Prêmio Gustavo",
  "version": "2.1.0",
  "description": "Workspace flutuante local para criar e preparar prompts para o Lovable sem chamadas externas de IA.",
  "permissions": ["storage", "clipboardWrite", "activeTab", "tabs"],
  "action": {
    "default_title": "Sessão Prêmio Gustavo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}